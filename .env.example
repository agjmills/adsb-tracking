# Site
HOME_LAT=52.254094
HOME_LON=-2.149912
SITE_NAME=Droitwich, UK
SITE_ALT=50m
TZ=Europe/London

# ADS-B hardware
READSB_DEVICE_TYPE=rtlsdr
READSB_RTLSDR_DEVICE=00001000
READSB_GAIN=auto

# Feeder IDs (get yours from FlightAware / ADSB Exchange)
PIAWARE_FEEDER_ID=your-feeder-id-here
ADSX_UUID=your-uuid-here
ADSX_SITENAME=My Station

# Hostname (points to the leaderboard; radar is proxied internally)
ADSB_HOST=ads-b.example.com

# Leaderboard
DUMP1090_URL=http://ultrafeeder/data/aircraft.json
POLL_INTERVAL=5
CLEANUP_HOURS=48

# Traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cloudflare
